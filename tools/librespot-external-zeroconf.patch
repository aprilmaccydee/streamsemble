     ("libmdns", Some(launch_libmdns)),
     #[cfg(not(feature = "with-libmdns"))]
     ("libmdns", None),
+    // Last, so it is never picked as the default.
+    ("external", Some(launch_external)),
 ];
 
+/// No-op backend: only the zeroconf HTTP server runs, and the embedding
+/// application announces `_spotify-connect._tcp` for the port itself. For
+/// hosts where the embedder already owns a working mDNS responder and a second
+/// one in this process cannot come up.
+fn launch_external(
+    name: Cow<'static, str>,
+    _zeroconf_ip: Vec<std::net::IpAddr>,
+    port: u16,
+    _status_tx: mpsc::UnboundedSender<DiscoveryEvent>,
+) -> Result<DnsSdHandle, Error> {
+    let (shutdown_tx, shutdown_rx) = oneshot::channel();
+
+    let task_handle = tokio::spawn(async move {
+        log::info!(
+            "Zeroconf server for '{name}' on port {port}; announcement left to an external mDNS responder"
+        );
+        let _ = shutdown_rx.await;
+    });
+
+    Ok(DnsSdHandle {
+        shutdown_tx,
+        task_handle,
+    })
+}
+
