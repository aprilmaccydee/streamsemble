---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'start' | 'webui' | 'advanced' | '';
}
const { title, description, current = '' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const repo = 'https://github.com/aprilmaccydee/streamsemble';
const nav = [
  { href: `${base}quick-start/`, key: 'start', label: 'Quick start' },
  { href: `${base}web-ui/`, key: 'webui', label: 'Web UI' },
  { href: `${base}advanced/`, key: 'advanced', label: 'Advanced' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Geist:wght@400;500;600;700&family=Geist+Mono&display=swap"
    />
  </head>
  <body>
    <nav class="nav-pill" aria-label="Primary">
      <a class="wordmark" href={base}>
        <svg class="mark" width="15" height="15" viewBox="0 0 64 64" aria-hidden="true">
          <rect x="8" y="28" width="12" height="24" rx="6" fill="currentColor" />
          <rect x="26" y="12" width="12" height="40" rx="6" fill="currentColor" />
          <rect x="44" y="20" width="12" height="32" rx="6" fill="currentColor" />
        </svg>
        <span class="wordmark-text">Streamsemble</span>
      </a>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="nav-gh"><a href={repo}>GitHub</a></li>
      </ul>
      <a class="nav-cta" href={`${base}quick-start/`}>Start</a>
    </nav>

    <slot />

    <footer class="foot-line">
      <div class="wrap">
        <p>Streamsemble — a home audio hub by April MacDonald · free under <a href={`${repo}/blob/main/LICENSE`}>AGPL-3.0</a> · <a href={repo}>source on GitHub</a></p>
      </div>
    </footer>
  </body>
</html>
